# ---- Server ----
NODE_ENV=development
PORT=4173
SITE_URL=http://localhost:4173
# Use a dedicated DB user with a strong password in production (e.g. mongodb://USER:PASSWORD@HOST:27017/toto_fashion?authSource=admin)
# A replica set (even single-node) enables fully transactional stock deduction.
MONGODB_URI=mongodb://127.0.0.1:27017/toto_fashion
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-chars
SESSION_STORE=memory
COOKIE_SAMESITE=lax
TRUST_PROXY=0

# ---- SMS (Melipayamak) — leave the key empty in development to log codes to the console instead ----
MELIPAYAMAK_SHARED_KEY=
MELIPAYAMAK_BODY_ID=000000
MELIPAYAMAK_ORDER_BODY_ID=
MELIPAYAMAK_RESTOCK_BODY_ID=
OTP_EXPIRES_SECONDS=120

# ---- Payment ----
# true = mock gateway (no real money, no Zarinpal connection). Keep true until the real gateway is approved.
PAYMENT_MOCK=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_AMOUNT_UNIT=toman

# ---- Bootstrap super admin (synced on every start) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-12-chars
ADMIN_MOBILE=

# ---- Store rules (single source of truth; the frontend reads them from /api/orders/config) ----
SEED_ON_START=true
FREE_SHIPPING_THRESHOLD=2000000
STANDARD_SHIPPING_PRICE=120000
EXPRESS_SHIPPING_PRICE=220000
RETURN_WINDOW_DAYS=7
